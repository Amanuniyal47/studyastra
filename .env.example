# LLM provider: 'ollama' (fully local Qwen2.5 7B) or 'groq' (cloud API)
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60

# Local Ollama settings (Qwen2.5 7B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=2048
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_CONNECT_TIMEOUT_SECONDS=10.0
OLLAMA_READ_TIMEOUT_SECONDS=120.0
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_FACTOR=0.5
OLLAMA_RETRY_BACKOFF_MAX_SECONDS=3.0
OLLAMA_STREAM_IDLE_TIMEOUT_SECONDS=30.0
OLLAMA_KEEP_ALIVE=5m
OLLAMA_HEALTH_CHECK_TTL_SECONDS=20.0

# Groq Cloud settings (optional / fallback when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Summarization settings (token budget includes prompts, headers, and chunk text)
SUMMARY_MAX_BATCH_TOKENS=2400
SUMMARY_TOPIC_TOP_K=6
MAX_REDUCTION_LEVELS=6

# PDF layout-aware text extraction
PDF_LAYOUT_SORT_ENABLED=true

# Practice question generation settings
QUESTION_MAX_BATCH_TOKENS=2400
QUESTION_DEFAULT_COUNT=5
QUESTION_MAX_COUNT=20
QUESTION_TOPIC_TOP_K=6
QUESTION_MAX_RETRIES=1
QUESTION_MAX_OUTPUT_TOKENS=1400
QUESTION_MAX_PREVIOUS_STEMS=15

# Study notes & flashcards settings
NOTES_MAX_BATCH_TOKENS=2400
FLASHCARD_MAX_BATCH_TOKENS=2400
FLASHCARD_DEFAULT_COUNT=6
FLASHCARD_MAX_COUNT=20
FOLLOW_UP_DEFAULT_COUNT=3
EXPLANATION_MAX_TOKENS=800

# Interactive quiz evaluation settings
QUIZ_SHORT_ANSWER_EVALUATOR=llm
QUIZ_SHORT_ANSWER_CORRECT_THRESHOLD=0.75
QUIZ_SHORT_ANSWER_PARTIAL_THRESHOLD=0.40

# Local embedding model (independent of LLM provider)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Token-based chunking (defaults tuned for all-MiniLM-L6-v2 256-token limit)
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# Retrieval & local FAISS persistence
TOP_K=3
# VECTOR_STORE_DIR=data/vector_store
VECTOR_STORE_CLEANUP_STAGING=true
VECTOR_STORE_STAGING_MAX_AGE_SECONDS=3600.0

# Conversational PDF Chatbot settings (Stage 10)
CHAT_CONTEXT_WINDOW_TOKENS=4096
CHAT_MAX_HISTORY_TOKENS=1500
CHAT_OUTPUT_RESERVE_TOKENS=1000
CHAT_SYSTEM_PROMPT_RESERVE_TOKENS=400
CHAT_DOC_CONTEXT_RESERVE_TOKENS=1000
CHAT_MIN_RECENT_TURNS=2
CHAT_SUMMARY_MAX_TOKENS=300
CHAT_SAFETY_MARGIN_RATIO=0.10
CHAT_REWRITE_ENABLED=true
CHAT_REWRITE_TIMEOUT_SECONDS=5.0
CHAT_TOP_K=4
