# LLM provider (groq now; architecture ready for future ollama/qwen)
LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=60
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Summarization settings (token budget includes prompts, headers, and chunk text)
SUMMARY_MAX_BATCH_TOKENS=2400
SUMMARY_TOPIC_TOP_K=6

# Practice question generation settings
QUESTION_MAX_BATCH_TOKENS=2400
QUESTION_DEFAULT_COUNT=5
QUESTION_MAX_COUNT=20
QUESTION_TOPIC_TOP_K=6
QUESTION_MAX_RETRIES=1
QUESTION_MAX_OUTPUT_TOKENS=1400
QUESTION_MAX_PREVIOUS_STEMS=15

# Interactive quiz evaluation settings
QUIZ_SHORT_ANSWER_EVALUATOR=llm
QUIZ_SHORT_ANSWER_CORRECT_THRESHOLD=0.75
QUIZ_SHORT_ANSWER_PARTIAL_THRESHOLD=0.40

# Local embedding model (independent of LLM provider)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Token-based chunking (defaults tuned for all-MiniLM-L6-v2 256-token limit)
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# Retrieval & local FAISS persistence
TOP_K=3
# VECTOR_STORE_DIR=data/vector_store
